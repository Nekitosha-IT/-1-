&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Если ПустаяСтрока(АдресУТМ) Тогда
        АдресУТМ = "http://localhost:8080";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРешение(Команда)
    Если ПустаяСтрока(FSRAR_ID) Тогда
        Результат = "Ошибка: заполните FSRAR_ID получателя.";
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(WBRegId) Тогда
        Результат = "Ошибка: заполните WBRegId ТТН.";
        Возврат;
    КонецЕсли;

    Результат = ОтправитьRequestRepealWBНаСервере(АдресУТМ, FSRAR_ID, WBRegId);
КонецПроцедуры

&НаСервере
Функция ОтправитьRequestRepealWBНаСервере(АдресУТМПараметр, FSRAR_IDПараметр, WBRegIdПараметр) Экспорт

    Адрес = СокрЛП(АдресУТМПараметр);
    Если Лев(НРег(Адрес), 7) = "http://" Тогда
        Адрес = Сред(Адрес, 8);
    ИначеЕсли Лев(НРег(Адрес), 8) = "https://" Тогда
        Адрес = Сред(Адрес, 9);
    КонецЕсли;

    ПозицияДвоеточия = СтрНайти(Адрес, ":");
    ПозицияСлеша = СтрНайти(Адрес, "/");

    Если ПозицияСлеша = 0 Тогда
        ХостПорт = Адрес;
    Иначе
        ХостПорт = Лев(Адрес, ПозицияСлеша - 1);
    КонецЕсли;

    Если СтрНайти(ХостПорт, ":") > 0 Тогда
        ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
        Сервер = Лев(ХостПорт, ПозицияДвоеточия - 1);
        Порт = Число(Сред(ХостПорт, ПозицияДвоеточия + 1));
    Иначе
        Сервер = ХостПорт;
        Порт = 8080;
    КонецЕсли;

    Соединение = Новый HTTPСоединение(Сервер, Порт, , , , 30);

    ДатаЗапроса = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss");
    НомерЗапроса = Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");

    XML = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
        + "<ns:Documents Version=\"1.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\""
        + " xmlns:ns=\"http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01\""
        + " xmlns:qp=\"http://fsrar.ru/WEGAIS/RequestRepealWB\">"
        + "<ns:Owner><ns:FSRAR_ID>" + FSRAR_IDПараметр + "</ns:FSRAR_ID></ns:Owner>"
        + "<ns:Document><ns:RequestRepealWB>"
        + "<qp:ClientId>" + FSRAR_IDПараметр + "</qp:ClientId>"
        + "<qp:RequestNumber>" + НомерЗапроса + "</qp:RequestNumber>"
        + "<qp:RequestDate>" + ДатаЗапроса + "</qp:RequestDate>"
        + "<qp:WBRegId>" + WBRegIdПараметр + "</qp:WBRegId>"
        + "</ns:RequestRepealWB></ns:Document></ns:Documents>";

    Граница = "----EgaisRepealBoundary7F3A9C21";
    Тело = "--" + Граница + Символы.ПС;
    Тело = Тело + "Content-Disposition: form-data; name=\"xml_file\"; filename=\"RequestRepealWB.xml\"" + Символы.ПС;
    Тело = Тело + "Content-Type: application/xml; charset=UTF-8" + Символы.ПС + Символы.ПС;
    Тело = Тело + XML + Символы.ПС;
    Тело = Тело + "--" + Граница + "--" + Символы.ПС;

    Запрос = Новый HTTPЗапрос("/opt/in/RequestRepealWB");
    Запрос.Метод = "POST";
    Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);

    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Код = Ответ.КодСостояния;
        ОтветТекст = Ответ.ПолучитьТелоКакСтроку();

        Возврат "HTTP " + Код + Символы.ПС + ОтветТекст;
    Исключение
        Возврат "Ошибка соединения с УТМ: " + ОписаниеОшибки();
    КонецПопытки;

КонецФункции
