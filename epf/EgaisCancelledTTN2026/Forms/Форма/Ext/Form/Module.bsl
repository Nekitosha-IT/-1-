&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АдресУТМ = "http://localhost:8080";
    ТаймаутУТМ = 15;
    СтатусУТМ = "УТМ: НЕ ПРОВЕРЕН";
    РаспроведеноКоличество = 0;
    ОшибокКоличество = 0;
    ВсегоОбработано = 0;
    ИндексОбработки = 0;
    ОбработкаЗапущена = Ложь;
    Результат = "Выберите входящие накладные.";
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУТМ(Команда)
    Если ОбработкаЗапущена Тогда
        Возврат;
    КонецЕсли;
    СтатусУТМ = "УТМ: ПРОВЕРКА...";
    Результат = "Проверяем доступность УТМ...";
    ПодключитьОбработчикОжидания("ПроверитьУТМОтложенно", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУТМОтложенно()
    ОтключитьОбработчикОжидания("ПроверитьУТМОтложенно");
    Ответ = ПроверитьУТМНаСервере(АдресУТМ, ТаймаутУТМ);
    Если Ответ.Успешно Тогда
        СтатусУТМ = "УТМ: РАБОТАЕТ";
        Результат = "УТМ доступен.";
    Иначе
        СтатусУТМ = "УТМ: НЕ РАБОТАЕТ";
        Результат = "УТМ недоступен: " + Ответ.Сообщение;
        Сообщить(Результат, СтатусСообщения.Важное);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьУТМНаСервере(Адрес, Таймаут) Экспорт
    Результат = Новый Структура("Успешно,Сообщение", Ложь, "");
    Если ПустаяСтрока(Адрес) Тогда
        Результат.Сообщение = "Не указан адрес УТМ.";
        Возврат Результат;
    КонецЕсли;
    Попытка
        Сервер = Адрес;
        Порт = 80;
        Если Лев(НРег(Сервер), 7) = "http://" Тогда
            Сервер = Сред(Сервер, 8);
        ИначеЕсли Лев(НРег(Сервер), 8) = "https://" Тогда
            Сервер = Сред(Сервер, 9);
            Порт = 443;
        КонецЕсли;
        Слеш = СтрНайти(Сервер, "/");
        Если Слеш > 0 Тогда
            Сервер = Лев(Сервер, Слеш - 1);
        КонецЕсли;
        Двоеточие = СтрНайти(Сервер, ":");
        Если Двоеточие > 0 Тогда
            Порт = Число(Сред(Сервер, Двоеточие + 1));
            Сервер = Лев(Сервер, Двоеточие - 1);
        КонецЕсли;
        Соединение = Новый HTTPСоединение(Сервер, Порт, , , , Таймаут);
        ОтветHTTP = Соединение.Получить(Новый HTTPЗапрос("/diagnosis"));
        Результат.Успешно = ОтветHTTP.КодСостояния >= 200 И ОтветHTTP.КодСостояния < 300;
        Результат.Сообщение = "HTTP " + Строка(ОтветHTTP.КодСостояния) + ".";
    Исключение
        Результат.Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыбратьВходящиеНакладные(Команда)
    Если ОбработкаЗапущена Тогда
        Возврат;
    КонецЕсли;
    Результат = "Поиск отменённых поставщиком входящих ТТН...";
    ПодключитьОбработчикОжидания("ЗагрузитьВходящиеНакладныеОтложенно", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВходящиеНакладныеОтложенно()
    ОтключитьОбработчикОжидания("ЗагрузитьВходящиеНакладныеОтложенно");
    Данные = ПолучитьПроведенныеОтмененныеПоставщиком();
    Если Не Данные.Успешно Тогда
        Результат = Данные.Сообщение;
        Сообщить(Результат, СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    ТаблицаТТН.Очистить();
    Для Каждого ДанныеДокумента Из Данные.Документы Цикл
        СтрокаТТН = ТаблицаТТН.Добавить();
        СтрокаТТН.Выбрана = Ложь;
        СтрокаТТН.Номер = ДанныеДокумента.Номер;
        СтрокаТТН.Дата = ДанныеДокумента.ДатаСтрокой;
        СтрокаТТН.Поставщик = ДанныеДокумента.Поставщик;
        СтрокаТТН.Статус = "Отменена поставщиком | Проведена в 1С";
    КонецЦикла;
    Результат = Данные.Сообщение;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМетаданныеДокументаЕГАИС() Экспорт
    Результат = Новый Структура("Найден,Имя,Синоним,Оценка,Диагностика", Ложь, "", "", 0, "");
    ЛучшийОбъект = Неопределено;
    ЛучшаяОценка = 0;
    Список = "";
    Попытка
        Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
            ИмяДок = НРег(Строка(ДокументМетаданные.Имя));
            СинонимДок = НРег(Строка(ДокументМетаданные.Синоним));
            Оценка = 0;
            Если СтрНайти(ИмяДок, "егаис") > 0 Тогда Оценка = Оценка + 100; КонецЕсли;
            Если СтрНайти(СинонимДок, "егаис") > 0 Тогда Оценка = Оценка + 120; КонецЕсли;
            Если СтрНайти(ИмяДок, "ттн") > 0 ИЛИ СтрНайти(СинонимДок, "ттн") > 0 Тогда Оценка = Оценка + 70; КонецЕсли;
            Если СтрНайти(ИмяДок, "накладн") > 0 ИЛИ СтрНайти(СинонимДок, "накладн") > 0 Тогда Оценка = Оценка + 50; КонецЕсли;
            Если СтрНайти(ИмяДок, "товарно") > 0 ИЛИ СтрНайти(СинонимДок, "товарно") > 0 Тогда Оценка = Оценка + 30; КонецЕсли;
            Если СтрНайти(ИмяДок, "транспорт") > 0 ИЛИ СтрНайти(СинонимДок, "транспорт") > 0 Тогда Оценка = Оценка + 20; КонецЕсли;
            Для Каждого Реквизит Из ДокументМетаданные.Реквизиты Цикл
                ИмяРеквизита = НРег(Строка(Реквизит.Имя));
                СинонимРеквизита = НРег(Строка(Реквизит.Синоним));
                Если СтрНайти(ИмяРеквизита, "егаис") > 0 ИЛИ СтрНайти(СинонимРеквизита, "егаис") > 0 Тогда Оценка = Оценка + 15; КонецЕсли;
                Если СтрНайти(ИмяРеквизита, "ттн") > 0 ИЛИ СтрНайти(СинонимРеквизита, "ттн") > 0 Тогда Оценка = Оценка + 10; КонецЕсли;
                Если СтрНайти(ИмяРеквизита, "статус") > 0 ИЛИ СтрНайти(СинонимРеквизита, "статус") > 0 Тогда Оценка = Оценка + 5; КонецЕсли;
                Если СтрНайти(ИмяРеквизита, "состояни") > 0 ИЛИ СтрНайти(СинонимРеквизита, "состояни") > 0 Тогда Оценка = Оценка + 5; КонецЕсли;
            КонецЦикла;
            Если Оценка > 0 Тогда
                Если ПустаяСтрока(Список) Тогда
                    Список = Строка(ДокументМетаданные.Имя) + " / " + Строка(ДокументМетаданные.Синоним) + " = " + Строка(Оценка);
                Иначе
                    Список = Список + " | " + Строка(ДокументМетаданные.Имя) + " / " + Строка(ДокументМетаданные.Синоним) + " = " + Строка(Оценка);
                КонецЕсли;
            КонецЕсли;
            Если Оценка > ЛучшаяОценка Тогда
                ЛучшаяОценка = Оценка;
                ЛучшийОбъект = ДокументМетаданные;
            КонецЕсли;
        КонецЦикла;
        Если ЛучшийОбъект <> Неопределено Тогда
            Результат.Найден = Истина;
            Результат.Имя = ЛучшийОбъект.Имя;
            Результат.Синоним = Строка(ЛучшийОбъект.Синоним);
            Результат.Оценка = ЛучшаяОценка;
            Результат.Диагностика = Список;
        Иначе
            Результат.Диагностика = "Документы-кандидаты не найдены.";
        КонецЕсли;
    Исключение
        Результат.Диагностика = "Ошибка анализа метаданных: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоОтмененаПоставщиком(СсылкаДокумента) Экспорт
    Попытка
        Объект = СсылкаДокумента.ПолучитьОбъект();
        Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
            Имя = НРег(Строка(Реквизит.Имя));
            Синоним = НРег(Строка(Реквизит.Синоним));
            ЭтоРеквизитСтатуса = СтрНайти(Имя, "статус") > 0 ИЛИ СтрНайти(Имя, "состояни") > 0 ИЛИ СтрНайти(Имя, "отмен") > 0 ИЛИ СтрНайти(Синоним, "статус") > 0 ИЛИ СтрНайти(Синоним, "состояни") > 0 ИЛИ СтрНайти(Синоним, "отмен") > 0;
            Если Не ЭтоРеквизитСтатуса Тогда
                Продолжить;
            КонецЕсли;
            Значение = Объект[Реквизит.Имя];
            Если Значение = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            ТекстЗначения = НРег(Строка(Значение));
            Если СтрНайти(ТекстЗначения, "отмен") > 0 И СтрНайти(ТекстЗначения, "постав") > 0 Тогда
                Возврат Истина;
            КонецЕсли;
        КонецЦикла;
    Исключение
        Возврат Ложь;
    КонецПопытки;
    Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПроведенныеОтмененныеПоставщиком() Экспорт
    Результат = Новый Структура("Успешно,Сообщение,Документы", Ложь, "", Новый Массив);
    Попытка
        МетаданныеДокумента = ПолучитьМетаданныеДокументаЕГАИС();
        Если Не МетаданныеДокумента.Найден Тогда
            Результат.Сообщение = "Не удалось определить документ входящей ЕГАИС-ТТН. " + МетаданныеДокумента.Диагностика;
            Возврат Результат;
        КонецЕсли;
        ИмяДокумента = МетаданныеДокумента.Имя;
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 500 ДокументЕГАИС.Ссылка КАК Ссылка, ДокументЕГАИС.Номер КАК Номер, ДокументЕГАИС.Дата КАК Дата ИЗ Документ." + ИмяДокумента + " КАК ДокументЕГАИС ГДЕ ДокументЕГАИС.Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО ДокументЕГАИС.Дата УБЫВ";
        Выборка = Запрос.Выполнить().Выбрать();
        КоличествоПроведенных = 0;
        КоличествоОтмененных = 0;
        Пока Выборка.Следующий() Цикл
            КоличествоПроведенных = КоличествоПроведенных + 1;
            Если Не ЭтоОтмененаПоставщиком(Выборка.Ссылка) Тогда
                Продолжить;
            КонецЕсли;
            КоличествоОтмененных = КоличествоОтмененных + 1;
            СтрокаДанных = Новый Структура("Ссылка,Номер,ДатаСтрокой,Поставщик", Выборка.Ссылка, Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss"), ПолучитьПоставщикаДокумента(Выборка.Ссылка));
            Результат.Документы.Добавить(СтрокаДанных);
        КонецЦикла;
        Результат.Успешно = Истина;
        Результат.Сообщение = "Документ " + ИмяДокумента + " (" + МетаданныеДокумента.Синоним + "). Проведённых проверено: " + Строка(КоличествоПроведенных) + ". Отменённых поставщиком найдено: " + Строка(КоличествоОтмененных) + ".";
    Исключение
        Результат.Сообщение = "Ошибка поиска отменённых поставщиком ТТН: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоставщикаДокумента(СсылкаДокумента) Экспорт
    Попытка
        Объект = СсылкаДокумента.ПолучитьОбъект();
        Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
            Имя = НРег(Строка(Реквизит.Имя));
            Синоним = НРег(Строка(Реквизит.Синоним));
            Если СтрНайти(Имя, "контраг") > 0 ИЛИ СтрНайти(Имя, "поставщик") > 0 ИЛИ СтрНайти(Синоним, "контраг") > 0 ИЛИ СтрНайти(Синоним, "поставщик") > 0 Тогда
                Значение = Объект[Реквизит.Имя];
                Если ЗначениеЗаполнено(Значение) Тогда
                    Возврат Строка(Значение);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат "Не определён";
КонецФункции

&НаКлиенте
Процедура ВыбратьВсе(Команда)
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        СтрокаТТН.Выбрана = Истина;
    КонецЦикла;
    Результат = "Выбраны все найденные отменённые поставщиком накладные.";
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        СтрокаТТН.Выбрана = Ложь;
    КонецЦикла;
    Результат = "Выбор снят.";
КонецПроцедуры

&НаКлиенте
Процедура РаспровестиВыбранные(Команда)
    Если ОбработкаЗапущена Тогда
        Возврат;
    КонецЕсли;
    ЕстьВыбранные = Ложь;
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        Если СтрокаТТН.Выбрана Тогда
            ЕстьВыбранные = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если Не ЕстьВыбранные Тогда
        Сообщить("Не выбраны накладные.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    РаспроведеноКоличество = 0;
    ОшибокКоличество = 0;
    ВсегоОбработано = 0;
    ИндексОбработки = 0;
    ОбработкаЗапущена = Истина;
    Результат = "Начинаем распроведение...";
    ПодключитьОбработчикОжидания("ОбработатьСледующуюНакладную", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСледующуюНакладную() Экспорт
    Пока ИндексОбработки < ТаблицаТТН.Количество() Цикл
        СтрокаТТН = ТаблицаТТН[ИндексОбработки];
        ИндексОбработки = ИндексОбработки + 1;
        Если Не СтрокаТТН.Выбрана Тогда
            Продолжить;
        КонецЕсли;
        СтрокаТТН.Статус = "Обработка...";
        ВсегоОбработано = ВсегоОбработано + 1;
        Ответ = РаспровестиДокумент(СтрокаТТН.Номер, СтрокаТТН.Дата);
        Если Ответ.Успешно Тогда
            СтрокаТТН.Статус = "Распроведена";
            РаспроведеноКоличество = РаспроведеноКоличество + 1;
        Иначе
            СтрокаТТН.Статус = "Ошибка: " + Ответ.Сообщение;
            ОшибокКоличество = ОшибокКоличество + 1;
        КонецЕсли;
        СтрокаТТН.Выбрана = Ложь;
        Результат = "Распроведено: " + Строка(РаспроведеноКоличество) + " | С ошибками: " + Строка(ОшибокКоличество) + " | Всего обработано: " + Строка(ВсегоОбработано);
        Возврат;
    КонецЦикла;
    ОтключитьОбработчикОжидания("ОбработатьСледующуюНакладную");
    ОбработкаЗапущена = Ложь;
    Сообщить("Готово. Распроведено: " + Строка(РаспроведеноКоличество) + "; ошибок: " + Строка(ОшибокКоличество) + ".");
КонецПроцедуры

&НаСервереБезКонтекста
Функция РаспровестиДокумент(НомерДокумента, ДатаСтрокой) Экспорт
    Результат = Новый Структура("Успешно,Сообщение", Ложь, "");
    Попытка
        МетаданныеДокумента = ПолучитьМетаданныеДокументаЕГАИС();
        Если Не МетаданныеДокумента.Найден Тогда
            Результат.Сообщение = "Не найден тип документа ЕГАИС-ТТН.";
            Возврат Результат;
        КонецЕсли;
        ИмяДокумента = МетаданныеДокумента.Имя;
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 50 ДокументЕГАИС.Ссылка КАК Ссылка, ДокументЕГАИС.Номер КАК Номер, ДокументЕГАИС.Дата КАК Дата ИЗ Документ." + ИмяДокумента + " КАК ДокументЕГАИС ГДЕ ДокументЕГАИС.Номер = &Номер УПОРЯДОЧИТЬ ПО ДокументЕГАИС.Дата УБЫВ";
        Запрос.УстановитьПараметр("Номер", НомерДокумента);
        Выборка = Запрос.Выполнить().Выбрать();
        СсылкаДокумента = Неопределено;
        Пока Выборка.Следующий() Цикл
            Если Формат(Выборка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss") = ДатаСтрокой Тогда
                Если ЭтоОтмененаПоставщиком(Выборка.Ссылка) Тогда
                    СсылкаДокумента = Выборка.Ссылка;
                    Прервать;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если СсылкаДокумента = Неопределено Тогда
            Результат.Сообщение = "Документ с номером " + Строка(НомерДокумента) + " и датой " + ДатаСтрокой + " не найден или уже не имеет статуса отмены поставщиком.";
            Возврат Результат;
        КонецЕсли;
        ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
        Если Не ОбъектДокумента.Проведен Тогда
            Результат.Сообщение = "Документ уже распроведен.";
            Возврат Результат;
        КонецЕсли;
        Зависимость = НайтиСвязанноеПоступление(СсылкаДокумента);
        Если Зависимость.Найден Тогда
            Результат.Сообщение = "Есть зависимый документ ПоступлениеТоваровУслуги № " + Зависимость.Номер;
            Возврат Результат;
        КонецЕсли;
        ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        ОбъектПослеЗаписи = СсылкаДокумента.ПолучитьОбъект();
        Если ОбъектПослеЗаписи.Проведен Тогда
            Результат.Сообщение = "1С не сняла проведение документа после записи.";
            Возврат Результат;
        КонецЕсли;
        Результат.Успешно = Истина;
        Результат.Сообщение = "Распроведена.";
    Исключение
        Результат.Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСвязанноеПоступление(СсылкаЕГАИС) Экспорт
    Результат = Новый Структура("Найден,Номер", Ложь, "");
    Попытка
        МетаПоступления = Метаданные.Документы.Найти("ПоступлениеТоваровУслуги");
        Если МетаПоступления = Неопределено Тогда
            Возврат Результат;
        КонецЕсли;
        Для Каждого Реквизит Из МетаПоступления.Реквизиты Цикл
            Имя = НРег(Строка(Реквизит.Имя));
            Синоним = НРег(Строка(Реквизит.Синоним));
            ЭтоКандидат = СтрНайти(Имя, "егаис") > 0 ИЛИ СтрНайти(Имя, "ттн") > 0 ИЛИ СтрНайти(Имя, "основан") > 0 ИЛИ СтрНайти(Имя, "заказ") > 0 ИЛИ СтрНайти(Синоним, "егаис") > 0 ИЛИ СтрНайти(Синоним, "ттн") > 0 ИЛИ СтрНайти(Синоним, "основан") > 0 ИЛИ СтрНайти(Синоним, "заказ") > 0;
            Если Не ЭтоКандидат Тогда
                Продолжить;
            КонецЕсли;
            Попытка
                Запрос = Новый Запрос;
                Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Док.Ссылка КАК Ссылка, Док.Номер КАК Номер ИЗ Документ.ПоступлениеТоваровУслуги КАК Док ГДЕ Док." + Реквизит.Имя + " = &Ссылка";
                Запрос.УстановитьПараметр("Ссылка", СсылкаЕГАИС);
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Результат.Найден = Истина;
                    Результат.Номер = Выборка.Номер;
                    Возврат Результат;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СформироватьОтчет(Команда)
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ВывестиТекст("ЕГАИС — распроведение входящих ТТН, отменённых поставщиком");
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("Номер" + Символы.Таб + "Дата" + Символы.Таб + "Поставщик" + Символы.Таб + "Статус");
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        ТабДок.ВывестиТекст(СтрокаТТН.Номер + Символы.Таб + СтрокаТТН.Дата + Символы.Таб + СтрокаТТН.Поставщик + Символы.Таб + СтрокаТТН.Статус);
    КонецЦикла;
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст(Результат);
    ТабДок.Показать("Отчёт ЕГАИС");
КонецПроцедуры
