&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АдресУТМ = "http://localhost:8080";
    ТаймаутУТМ = 30;
    УТМДоступен = Ложь;
    СтатусыПолучены = Ложь;
    Результат = "Готово. Нажмите «Получить данные из УТМ».";
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеИзУТМ(Команда)
    Если ПустаяСтрока(АдресУТМ) Тогда
        Результат = "Не указан адрес УТМ.";
        Возврат;
    КонецЕсли;

    Ответ = ПолучитьСтатусыУТМНаСервере(АдресУТМ, ТаймаутУТМ);
    УТМДоступен = Ложь;
    СтатусыПолучены = Ложь;

    Если Ответ = Неопределено Тогда
        Результат = "УТМ не вернул результат. Исправление запрещено.";
        Возврат;
    КонецЕсли;

    Если Не Ответ.Успешно Тогда
        Результат = Ответ.Сообщение;
        Возврат;
    КонецЕсли;

    УТМДоступен = Истина;
    СтатусыПолучены = Истина;
    ТаблицаТТН.Очистить();

    Для каждого Данные Из Ответ.ТТН Цикл
        СтрокаТТН = ТаблицаТТН.Добавить();
        СтрокаТТН.НомерТТН = Данные.Номер;
        СтрокаТТН.Дата = Данные.Дата;
        СтрокаТТН.Контрагент = Данные.Контрагент;
        СтрокаТТН.СтатусЕГАИС = Данные.СтатусЕГАИС;
        СтрокаТТН.WBRegId = Данные.WBRegId;
        СтрокаТТН.ОтмененаПоставщиком = Данные.ОтмененаПоставщиком;

        Найдено = НайтиДокументТТННаСервере(Данные.Номер, Данные.WBRegId, Данные.Дата);
        Если Найдено.Найден Тогда
            СтрокаТТН.Документ1С = Найдено.Ссылка;
            СтрокаТТН.Статус1С = Найдено.Статус;
            СтрокаТТН.Расхождение = Данные.ОтмененаПоставщиком И Найдено.Проведен;
            Если СтрокаТТН.Расхождение Тогда
                СтрокаТТН.Причина = "ЕГАИС подтверждает отмену поставщиком, документ 1С проведён.";
            КонецЕсли;
        Иначе
            СтрокаТТН.Статус1С = "Не найден";
            СтрокаТТН.Расхождение = Истина;
            СтрокаТТН.Причина = "ТТН есть в УТМ, но документ 1С не найден.";
        КонецЕсли;
    КонецЦикла;

    Результат = "УТМ доступен. Получено ТТН: " + Строка(ТаблицаТТН.Количество()) + ".";
КонецПроцедуры

&НаКлиенте
Процедура РаспроводитьИПометить(Команда)
    Если Не СтатусыПолучены ИЛИ Не УТМДоступен Тогда
        Сообщить("Нет подтверждённого ответа УТМ. Операция запрещена.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    Для каждого СтрокаТТН Из ТаблицаТТН Цикл
        Если Не СтрокаТТН.Расхождение ИЛИ Не СтрокаТТН.ОтмененаПоставщиком Тогда
            Продолжить;
        КонецЕсли;

        Если СтрокаТТН.Документ1С = Неопределено Тогда
            ДобавитьЗаписьЖурнала(СтрокаТТН, "Не найден документ 1С", "Не выполнено", "Документ не найден.");
            Продолжить;
        КонецЕсли;

        Журнал = ДобавитьЗаписьЖурнала(СтрокаТТН, "Исправляется", "Распроведение + пометка", "Начато.");
        Ответ = ИсправитьДокументНаСервере(СтрокаТТН.Документ1С, СтрокаТТН.НомерТТН, СтрокаТТН.WBRegId, Истина);

        Если Ответ.Успешно Тогда
            Журнал.СтатусИсправления = "Исправлено";
            Журнал.Результат = Ответ.Сообщение;
            СтрокаТТН.Статус1С = "Не проведён, помечен на удаление";
            СтрокаТТН.Расхождение = Ложь;
        Иначе
            Журнал.СтатусИсправления = "Ошибка исправления";
            Журнал.Результат = Ответ.Сообщение;
        КонецЕсли;
    КонецЦикла;

    Результат = "Операция завершена. Результаты находятся в журнале исправлений.";
КонецПроцедуры

&НаКлиенте
Процедура ТолькоРаспроводить(Команда)
    Если Не СтатусыПолучены ИЛИ Не УТМДоступен Тогда
        Сообщить("Нет подтверждённого ответа УТМ. Операция запрещена.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    Для каждого СтрокаТТН Из ТаблицаТТН Цикл
        Если Не СтрокаТТН.Расхождение ИЛИ Не СтрокаТТН.ОтмененаПоставщиком Тогда Продолжить; КонецЕсли;

        Журнал = ДобавитьЗаписьЖурнала(СтрокаТТН, "Исправляется", "Только распровести", "Начато.");
        Ответ = ИсправитьДокументНаСервере(СтрокаТТН.Документ1С, СтрокаТТН.НомерТТН, СтрокаТТН.WBRegId, Ложь);
        Если Ответ.Успешно Тогда
            Журнал.СтатусИсправления = "Исправлено";
            Журнал.Результат = Ответ.Сообщение;
            СтрокаТТН.Статус1С = "Не проведён";
            СтрокаТТН.Расхождение = Ложь;
        Иначе
            Журнал.СтатусИсправления = "Ошибка исправления";
            Журнал.Результат = Ответ.Сообщение;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ДобавитьЗаписьЖурнала(СтрокаТТН, Статус, Действие, Результат)
    Журнал = ЖурналИсправлений.Добавить();
    Журнал.Время = ТекущаяДата();
    Журнал.НомерТТН = СтрокаТТН.НомерТТН;
    Журнал.WBRegId = СтрокаТТН.WBRegId;
    Журнал.Контрагент = СтрокаТТН.Контрагент;
    Журнал.СтатусИсправления = Статус;
    Журнал.Действие = Действие;
    Журнал.Результат = Результат;
    Возврат Журнал;
КонецФункции

&НаКлиенте
Процедура СформироватьОтчет(Команда)
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ВывестиТекст("ЕГАИС — контроль отменённых ТТН");
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("Номер ТТН\tДата\tКонтрагент\tСтатус 1С\tСтатус ЕГАИС\tРасхождение\tWBRegId\tПричина");
    Для каждого СтрокаТТН Из ТаблицаТТН Цикл
        ТабДок.ВывестиТекст(СтрокаТТН.НомерТТН + "\t" + Формат(СтрокаТТН.Дата, "ДФ=dd.MM.yyyy HH:mm:ss") + "\t" + СтрокаТТН.Контрагент + "\t" + СтрокаТТН.Статус1С + "\t" + СтрокаТТН.СтатусЕГАИС + "\t" + ?(СтрокаТТН.Расхождение, "ДА", "НЕТ") + "\t" + СтрокаТТН.WBRegId + "\t" + СтрокаТТН.Причина);
    КонецЦикла;
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("Журнал исправлений");
    ТабДок.ВывестиТекст("Время\tНомер ТТН\tWBRegId\tСтатус\tДействие\tРезультат");
    Для каждого Журнал Из ЖурналИсправлений Цикл
        ТабДок.ВывестиТекст(Формат(Журнал.Время, "ДФ=dd.MM.yyyy HH:mm:ss") + "\t" + Журнал.НомерТТН + "\t" + Журнал.WBRegId + "\t" + Журнал.СтатусИсправления + "\t" + Журнал.Действие + "\t" + Журнал.Результат);
    КонецЦикла;
    ТабДок.Показать("Отчёт ЕГАИС");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтатусыУТМНаСервере(АдресУТМ, Таймаут) Экспорт
    Результат = Новый Структура("Успешно,Сообщение,ТТН", Ложь, "", Новый Массив);
    Попытка
        Сервер = АдресУТМ;
        Порт = 80;
        Если СтрНайти(НРег(Сервер), "http://") = 1 Тогда Сервер = Сред(Сервер, 8); КонецЕсли;
        Если СтрНайти(НРег(Сервер), "https://") = 1 Тогда Сервер = Сред(Сервер, 9); Порт = 443; КонецЕсли;
        Если СтрНайти(Сервер, "/opt/out") > 0 Тогда Сервер = Лев(Сервер, СтрНайти(Сервер, "/opt/out") - 1); КонецЕсли;
        Двоеточие = СтрНайти(Сервер, ":");
        Если Двоеточие > 0 Тогда Порт = Число(Сред(Сервер, Двоеточие + 1)); Сервер = Лев(Сервер, Двоеточие - 1); КонецЕсли;
        Соединение = Новый HTTPСоединение(Сервер, Порт, , , , Таймаут);
        ReplyId = "";
        Для Счетчик = 1 По 100 Цикл
            Путь = "/opt/out";
            Если ReplyId <> "" Тогда Путь = Путь + "?replyId=" + ReplyId; КонецЕсли;
            Запрос = Новый HTTPЗапрос(Путь);
            Запрос.Заголовки.Вставить("Accept", "application/xml");
            Ответ = Соединение.Получить(Запрос);
            Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда
                Результат.Сообщение = "УТМ вернул HTTP " + Строка(Ответ.КодСостояния) + ".";
                Возврат Результат;
            КонецЕсли;
            XMLТекст = Ответ.ПолучитьТелоКакСтроку();
            Если ПустаяСтрока(XMLТекст) Тогда Прервать; КонецЕсли;
            РазобратьXML(XMLТекст, Результат.ТТН);
            НовыйReplyId = ИзвлечьReplyId(XMLТекст);
            Если НовыйReplyId = "" ИЛИ НовыйReplyId = ReplyId Тогда Прервать; КонецЕсли;
            ReplyId = НовыйReplyId;
        КонецЦикла;
        Результат.Успешно = Истина;
        Результат.Сообщение = "Ответ УТМ получен. Документов: " + Строка(Результат.ТТН.Количество());
    Исключение
        Результат.Сообщение = "Ошибка УТМ: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура РазобратьXML(XMLТекст, МассивТТН) Экспорт
    Чтение = Новый ЧтениеXML;
    Чтение.УстановитьСтроку(XMLТекст);
    Текущая = Неопределено;
    ТипДокумента = "";
    Тег = "";
    Пока Чтение.Прочитать() Цикл
        Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
            Тег = НРег(Чтение.Имя);
            Если Тег = "waybill" ИЛИ Тег = "actcancelcharge" Тогда
                Текущая = Новый Структура("Номер,Дата,Контрагент,WBRegId,СтатусЕГАИС,ОтмененаПоставщиком", "", Неопределено, "", "", "", Ложь);
                ТипДокумента = Тег;
                Если Тег = "actcancelcharge" Тогда
                    Текущая.СтатусЕГАИС = "Отменена поставщиком";
                    Текущая.ОтмененаПоставщиком = Истина;
                КонецЕсли;
            КонецЕсли;
        ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст И Текущая <> Неопределено Тогда
            Значение = СокрЛП(Чтение.Значение);
            Родитель = НРег(Чтение.ИмяРодителя);
            Если Родитель = "number" ИЛИ Родитель = "ttnnumber" Тогда Текущая.Номер = Значение; КонецЕсли;
            Если Родитель = "wbregid" Тогда Текущая.WBRegId = Значение; КонецЕсли;
            Если Родитель = "status" Тогда Текущая.СтатусЕГАИС = Значение; КонецЕсли;
            Если Родитель = "date" Тогда Текущая.Дата = Значение; КонецЕсли;
            Если Родитель = "identity" Тогда Текущая.Контрагент = Значение; КонецЕсли;
            Если СтрНайти(НРег(Значение), "отменена поставщиком") > 0 Тогда Текущая.ОтмененаПоставщиком = Истина; КонецЕсли;
        ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
            Если Текущая <> Неопределено И НРег(Чтение.Имя) = ТипДокумента Тогда
                МассивТТН.Добавить(Текущая);
                Текущая = Неопределено;
                ТипДокумента = "";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзвлечьReplyId(XMLТекст) Экспорт
    Попытка
        Чтение = Новый ЧтениеXML;
        Чтение.УстановитьСтроку(XMLТекст);
        Пока Чтение.Прочитать() Цикл
            Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И НРег(Чтение.Имя) = "replyid" Тогда
                Если Чтение.Прочитать() Тогда Возврат СокрЛП(Чтение.Значение); КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция НайтиДокументТТННаСервере(Номер, WBRegId, ДатаДокумента) Экспорт
    Результат = Новый Структура("Найден,Ссылка,Статус,Проведен", Ложь, Неопределено, "", Ложь);
    Для каждого МетаДок Из Метаданные.Документы Цикл
        Имя = НРег(МетаДок.Имя);
        Если СтрНайти(Имя, "ттн") = 0 И СтрНайти(Имя, "егис") = 0 И СтрНайти(Имя, "наклад") = 0 Тогда Продолжить; КонецЕсли;
        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 20 Док.Ссылка, Док.Номер, Док.Дата ИЗ Документ." + МетаДок.Имя + " КАК Док ГДЕ Док.Номер = &Номер УПОРЯДОЧИТЬ ПО Док.Дата УБЫВ";
            Запрос.УстановитьПараметр("Номер", Номер);
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                Результат.Найден = Истина;
                Результат.Ссылка = Выборка.Ссылка;
                Объект = Выборка.Ссылка.ПолучитьОбъект();
                Результат.Проведен = Объект.Проведен;
                Результат.Статус = ?(Объект.Проведен, "Проведен", "Не проведен");
                Возврат Результат;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ИсправитьДокументНаСервере(Ссылка, Номер, WBRegId, Пометить) Экспорт
    Результат = Новый Структура("Успешно,Сообщение", Ложь, "");
    Если Ссылка = Неопределено Тогда Результат.Сообщение = "Документ 1С не найден."; Возврат Результат; КонецЕсли;
    Попытка
        Объект = Ссылка.ПолучитьОбъект();
        Если Не Объект.Проведен Тогда
            Результат.Сообщение = "Документ уже не проведён.";
            Возврат Результат;
        КонецЕсли;

        НачатьТранзакцию();
        Попытка
            Если Объект.Движения.Количество() > 0 Тогда
                ОтменитьТранзакцию();
                Результат.Сообщение = "Автоматическое распроведение запрещено: у документа есть движения.";
                Возврат Результат;
            КонецЕсли;

            ЗаписатьПричину(Объект, "ЕГАИС: ТТН отменена поставщиком. WBRegId=" + WBRegId + ". Номер ТТН=" + Номер);
            Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
            Если Пометить Тогда
                Объект = Ссылка.ПолучитьОбъект();
                Объект.УстановитьПометкуУдаления(Истина);
                Объект.Записать();
            КонецЕсли;
            ЗафиксироватьТранзакцию();
            Результат.Успешно = Истина;
            Результат.Сообщение = ?(Пометить, "Распроведён и помечен на удаление.", "Распроведён.");
        Исключение
            ОтменитьТранзакцию();
            Результат.Сообщение = ОписаниеОшибки();
        КонецПопытки;
    Исключение
        Результат.Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьПричину(Объект, Причина) Экспорт
    Попытка
        Для каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
            Имя = НРег(Реквизит.Имя);
            Если СтрНайти(Имя, "комментар") > 0 И Реквизит.Тип.Типы().Количество() > 0 Тогда
                Если Реквизит.Тип.Типы()[0] = Тип("Строка") Тогда
                    Старое = Объект[Реквизит.Имя];
                    Объект[Реквизит.Имя] = ?(ПустаяСтрока(Старое), Причина, Старое + Символы.ПС + Причина);
                    Возврат;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
КонецПроцедуры
