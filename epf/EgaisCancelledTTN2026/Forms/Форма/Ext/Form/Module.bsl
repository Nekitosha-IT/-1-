&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АдресУТМ = "http://localhost:8080";
    ТаймаутУТМ = 10;
    СтатусУТМ = "🔴 УТМ: НЕ ПРОВЕРЕН";
    РаспроведеноКоличество = 0;
    ОшибокКоличество = 0;
    ВсегоОбработано = 0;
    ИндексОбработки = 0;
    ОбработкаЗапущена = Ложь;
    Результат = "Выберите входящие накладные.";
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУТМ(Команда)
    СтатусУТМ = "🟡 УТМ: ПРОВЕРКА...";
    Результат = "Проверяем доступность УТМ...";
    Ответ = ПроверитьУТМНаСервере(АдресУТМ, ТаймаутУТМ);
    Если Ответ.Успешно Тогда
        СтатусУТМ = "🟢 УТМ: РАБОТАЕТ";
        Результат = "УТМ доступен.";
        Сообщить("УТМ доступен");
    Иначе
        СтатусУТМ = "🔴 УТМ: НЕ РАБОТАЕТ";
        Результат = "УТМ недоступен: " + Ответ.Сообщение;
        Сообщить("УТМ недоступен: " + Ответ.Сообщение, СтатусСообщения.Важное);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьУТМНаСервере(Адрес, Таймаут) Экспорт
    Результат = Новый Структура("Успешно,Сообщение", Ложь, "");
    Попытка
        Сервер = Адрес;
        Порт = 80;
        Если Лев(НРег(Сервер), 7) = "http://" Тогда
            Сервер = Сред(Сервер, 8);
        ИначеЕсли Лев(НРег(Сервер), 8) = "https://" Тогда
            Сервер = Сред(Сервер, 9);
            Порт = 443;
        КонецЕсли;
        Позиция = СтрНайти(Сервер, ":");
        Если Позиция > 0 Тогда
            Порт = Число(Сред(Сервер, Позиция + 1));
            Сервер = Лев(Сервер, Позиция - 1);
        КонецЕсли;
        Соединение = Новый HTTPСоединение(Сервер, Порт, , , , Таймаут);
        ОтветHTTP = Соединение.Получить(Новый HTTPЗапрос("/diagnosis"));
        Если ОтветHTTP.КодСостояния < 200 ИЛИ ОтветHTTP.КодСостояния >= 300 Тогда
            Результат.Сообщение = "HTTP " + Строка(ОтветHTTP.КодСостояния);
            Возврат Результат;
        КонецЕсли;
        Результат.Успешно = Истина;
        Результат.Сообщение = "ОК";
    Исключение
        Результат.Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыбратьВходящиеНакладные(Команда)
    Данные = ПолучитьПроведенныеЕГАИСЗаказы();
    Если Не Данные.Успешно Тогда
        Сообщить(Данные.Сообщение, СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    ТаблицаТТН.Очистить();
    Для Каждого ДанныеДокумента Из Данные.Документы Цикл
        СтрокаТТН = ТаблицаТТН.Добавить();
        СтрокаТТН.Выбрана = Истина;
        СтрокаТТН.СсылкаНаДокумент = ДанныеДокумента.Ссылка;
        СтрокаТТН.Номер = ДанныеДокумента.Номер;
        СтрокаТТН.Дата = ДанныеДокумента.Дата;
        СтрокаТТН.Поставщик = ДанныеДокумента.Поставщик;
        СтрокаТТН.Статус = "Готова";
    КонецЦикла;
    Результат = "Загружено входящих ЕГАИСЗаказ: " + Строка(ТаблицаТТН.Количество()) + ". Все отмечены.";
    Сообщить(Результат);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроведенныеЕГАИСЗаказы() Экспорт
    Результат = Новый Структура("Успешно,Сообщение,Документы", Ложь, "", Новый Массив);
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |    ЕГАИСЗаказ.Ссылка КАК Ссылка,
        |    ЕГАИСЗаказ.Номер КАК Номер,
        |    ЕГАИСЗаказ.Дата КАК Дата
        |ИЗ
        |    Документ.ЕГАИСЗаказ КАК ЕГАИСЗаказ
        |ГДЕ
        |    ЕГАИСЗаказ.Проведен";
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            СтрокаДанных = Новый Структура("Ссылка,Номер,Дата,Поставщик");
            СтрокаДанных.Ссылка = Выборка.Ссылка;
            СтрокаДанных.Номер = Выборка.Номер;
            СтрокаДанных.Дата = Выборка.Дата;
            СтрокаДанных.Поставщик = "";
            Попытка
                ОбъектДокумента = Выборка.Ссылка.ПолучитьОбъект();
                СтрокаДанных.Поставщик = Строка(ОбъектДокумента.Контрагент);
            Исключение
                СтрокаДанных.Поставщик = "Не определён";
            КонецПопытки;
            Результат.Документы.Добавить(СтрокаДанных);
        КонецЦикла;
        Результат.Успешно = Истина;
    Исключение
        Результат.Сообщение = "Ошибка загрузки ЕГАИСЗаказ: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыбратьВсе(Команда)
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        СтрокаТТН.Выбрана = Истина;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        СтрокаТТН.Выбрана = Ложь;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура РаспровестиВыбранные(Команда)
    Если ОбработкаЗапущена Тогда
        Возврат;
    КонецЕсли;
    ЕстьВыбранные = Ложь;
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        Если СтрокаТТН.Выбрана Тогда
            ЕстьВыбранные = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если Не ЕстьВыбранные Тогда
        Сообщить("Не выбраны накладные.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    РаспроведеноКоличество = 0;
    ОшибокКоличество = 0;
    ВсегоОбработано = 0;
    ИндексОбработки = 0;
    ОбработкаЗапущена = Истина;
    СтатусУТМ = "🟡 УТМ: ОБРАБОТКА...";
    Результат = "Начинаем распроведение...";
    ПодключитьОбработчикОжидания("ОбработатьСледующуюНакладную", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСледующуюНакладную() Экспорт
    Пока ИндексОбработки < ТаблицаТТН.Количество() Цикл
        СтрокаТТН = ТаблицаТТН[ИндексОбработки];
        ИндексОбработки = ИндексОбработки + 1;
        Если Не СтрокаТТН.Выбрана Тогда
            Продолжить;
        КонецЕсли;
        СтрокаТТН.Статус = "🟡 Обработка...";
        ВсегоОбработано = ВсегоОбработано + 1;
        Ответ = РаспровестиЕГАИСЗаказ(СтрокаТТН.СсылкаНаДокумент);
        Если Ответ.Успешно Тогда
            СтрокаТТН.Статус = "🟢 Распроведена";
            СтрокаТТН.Выбрана = Ложь;
            РаспроведеноКоличество = РаспроведеноКоличество + 1;
        Иначе
            СтрокаТТН.Статус = "🔴 Ошибка: " + Ответ.Сообщение;
            ОшибокКоличество = ОшибокКоличество + 1;
        КонецЕсли;
        Результат = "Распроведено: " + Строка(РаспроведеноКоличество) + " | С ошибками: " + Строка(ОшибокКоличество) + " | Обработано: " + Строка(ВсегоОбработано);
        Сообщить("ТТН " + СтрокаТТН.Номер + ": " + СтрокаТТН.Статус);
        Возврат;
    КонецЦикла;
    ОтключитьОбработчикОжидания("ОбработатьСледующуюНакладную");
    ОбработкаЗапущена = Ложь;
    СтатусУТМ = "🟢 УТМ: РАБОТАЕТ";
    Сообщить("Готово. Распроведено: " + Строка(РаспроведеноКоличество) + "; ошибок: " + Строка(ОшибокКоличество) + ".");
КонецПроцедуры

&НаСервереБезКонтекста
Функция РаспровестиЕГАИСЗаказ(СсылкаДокумента) Экспорт
    Результат = Новый Структура("Успешно,Сообщение", Ложь, "");
    Попытка
        Если СсылкаДокумента = Неопределено Тогда
            Результат.Сообщение = "Пустая ссылка.";
            Возврат Результат;
        КонецЕсли;
        ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
        Если Не ОбъектДокумента.Проведен Тогда
            Результат.Сообщение = "Документ уже распроведен.";
            Возврат Результат;
        КонецЕсли;
        Зависимость = НайтиСвязанноеПоступление(СсылкаДокумента);
        Если Зависимость.Найден Тогда
            Результат.Сообщение = "есть зависимый документ ПоступлениеТоваровУслуги № " + Зависимость.Номер;
            Возврат Результат;
        КонецЕсли;
        ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Результат.Успешно = Истина;
        Результат.Сообщение = "Распроведена.";
    Исключение
        Результат.Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСвязанноеПоступление(СсылкаЕГАИСЗаказ) Экспорт
    Результат = Новый Структура("Найден,Номер", Ложь, "");
    Варианты = Новый Массив;
    Варианты.Добавить("ЕГАИСЗаказ");
    Варианты.Добавить("ДокументЕГАИСЗаказ");
    Варианты.Добавить("Основание");
    Для Каждого ИмяРеквизита Из Варианты Цикл
        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |    Поступление.Ссылка КАК Ссылка,
            |    Поступление.Номер КАК Номер
            |ИЗ
            |    Документ.ПоступлениеТоваровУслуги КАК Поступление
            |ГДЕ
            |    Поступление.Проведен
            |    И Поступление." + ИмяРеквизита + " = &Ссылка";
            Запрос.УстановитьПараметр("Ссылка", СсылкаЕГАИСЗаказ);
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                Результат.Найден = Истина;
                Результат.Номер = Выборка.Номер;
                Возврат Результат;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СформироватьОтчет(Команда)
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ВывестиТекст("ЕГАИС — распроведение входящих ТТН");
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("Номер\tДата\tПоставщик\tСтатус");
    Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
        ТабДок.ВывестиТекст(СтрокаТТН.Номер + "\t" + Формат(СтрокаТТН.Дата, "ДФ=dd.MM.yyyy HH:mm:ss") + "\t" + СтрокаТТН.Поставщик + "\t" + СтрокаТТН.Статус);
    КонецЦикла;
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст(Результат);
    ТабДок.Показать("Распроведение входящих ТТН");
КонецПроцедуры
