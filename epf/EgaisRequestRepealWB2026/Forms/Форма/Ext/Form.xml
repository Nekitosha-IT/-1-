<?xml version="1.0" encoding="UTF-8"?>
<Form xmlns="http://v8.1c.ru/8.3/xcf/logform" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:xr="http://v8.1c.ru/8.3/xcf/readable" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="2.17">
  <Title>
    <v8:item><v8:lang>ru</v8:lang><v8:content>ЕГАИС — Аннулирование ТТН</v8:content></v8:item>
  </Title>
  <AutoTitle>false</AutoTitle>
  <AutoCommandBar name="ФормаКоманднаяПанель" id="-1">
    <Autofill>false</Autofill>
  </AutoCommandBar>
  <ChildItems>
    <UsualGroup name="Подключение" id="1">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Подключение к ЕГАИС</v8:content></v8:item>
      </Title>
      <Representation>None</Representation>
      <ShowTitle>true</ShowTitle>
      <ChildItems>
        <InputField name="УТМ" id="2">
          <DataPath>АдресУТМ</DataPath>
          <TitleLocation>Left</TitleLocation>
          <Width>35</Width>
        </InputField>
        <Button name="ВыбратьУТМ" id="3">
          <Type>UsualButton</Type>
          <Title>
            <v8:item><v8:lang>ru</v8:lang><v8:content>Выбрать УТМ</v8:content></v8:item>
          </Title>
          <CommandName>Form.Command.ВыбратьУТМ</CommandName>
        </Button>
        <InputField name="ФСРАР" id="4">
          <DataPath>FSRAR_ID</DataPath>
          <TitleLocation>Left</TitleLocation>
          <Width>25</Width>
        </InputField>
      </ChildItems>
    </UsualGroup>

    <UsualGroup name="Накладная" id="5">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Товарно-транспортная накладная</v8:content></v8:item>
      </Title>
      <Representation>None</Representation>
      <ShowTitle>true</ShowTitle>
      <ChildItems>
        <InputField name="ОписаниеНакладной" id="6">
          <DataPath>ОписаниеНакладной</DataPath>
          <TitleLocation>Left</TitleLocation>
          <Width>55</Width>
        </InputField>
        <Button name="ВыбратьНакладную" id="7">
          <Type>UsualButton</Type>
          <Title>
            <v8:item><v8:lang>ru</v8:lang><v8:content>Выбрать накладную</v8:content></v8:item>
          </Title>
          <CommandName>Form.Command.ВыбратьНакладную</CommandName>
        </Button>
        <InputField name="ТТН" id="8">
          <DataPath>WBRegId</DataPath>
          <TitleLocation>Left</TitleLocation>
          <Width>55</Width>
        </InputField>
      </ChildItems>
    </UsualGroup>

    <LabelField name="Подсказка" id="9">
      <TitleLocation>None</TitleLocation>
      <Text>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Выберите УТМ и накладную. После выбора программа подставит FSRAR_ID и WBRegId. При необходимости WBRegId можно исправить вручную.</v8:content></v8:item>
      </Text>
    </LabelField>

    <Button name="АннулироватьТТН" id="10">
      <Type>UsualButton</Type>
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Сформировать запрос на аннулирование ТТН</v8:content></v8:item>
      </Title>
      <CommandName>Form.Command.ОтправитьЗапрос</CommandName>
    </Button>

    <LabelField name="Результат" id="11">
      <DataPath>Результат</DataPath>
      <TitleLocation>None</TitleLocation>
    </LabelField>
  </ChildItems>
  <Attributes>
    <Attribute name="АдресУТМ" id="1">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Адрес УТМ</v8:content></v8:item>
      </Title>
      <Type>
        <v8:Type>xs:string</v8:Type>
        <v8:StringQualifiers>
          <v8:Length>200</v8:Length>
          <v8:AllowedLength>Variable</v8:AllowedLength>
        </v8:StringQualifiers>
      </Type>
    </Attribute>
    <Attribute name="FSRAR_ID" id="2">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>FSRAR_ID организации</v8:content></v8:item>
      </Title>
      <Type>
        <v8:Type>xs:string</v8:Type>
        <v8:StringQualifiers>
          <v8:Length>20</v8:Length>
          <v8:AllowedLength>Variable</v8:AllowedLength>
        </v8:StringQualifiers>
      </Type>
    </Attribute>
    <Attribute name="WBRegId" id="3">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>WBRegId ЕГАИС</v8:content></v8:item>
      </Title>
      <Type>
        <v8:Type>xs:string</v8:Type>
        <v8:StringQualifiers>
          <v8:Length>100</v8:Length>
          <v8:AllowedLength>Variable</v8:AllowedLength>
        </v8:StringQualifiers>
      </Type>
    </Attribute>
    <Attribute name="ОписаниеНакладной" id="4">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Выбранная накладная</v8:content></v8:item>
      </Title>
      <Type>
        <v8:Type>xs:string</v8:Type>
        <v8:StringQualifiers>
          <v8:Length>300</v8:Length>
          <v8:AllowedLength>Variable</v8:AllowedLength>
        </v8:StringQualifiers>
      </Type>
    </Attribute>
    <Attribute name="Результат" id="5">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Результат</v8:content></v8:item>
      </Title>
      <Type>
        <v8:Type>xs:string</v8:Type>
        <v8:StringQualifiers>
          <v8:Length>4000</v8:Length>
          <v8:AllowedLength>Variable</v8:AllowedLength>
        </v8:StringQualifiers>
      </Type>
    </Attribute>
  </Attributes>
  <Commands>
    <Command name="ВыбратьУТМ" id="1">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Выбрать УТМ</v8:content></v8:item>
      </Title>
      <Action>ВыбратьУТМ</Action>
      <CurrentRowUse>DontUse</CurrentRowUse>
    </Command>
    <Command name="ВыбратьНакладную" id="2">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Выбрать накладную</v8:content></v8:item>
      </Title>
      <Action>ВыбратьНакладную</Action>
      <CurrentRowUse>DontUse</CurrentRowUse>
    </Command>
    <Command name="ОтправитьЗапрос" id="3">
      <Title>
        <v8:item><v8:lang>ru</v8:lang><v8:content>Сформировать запрос на аннулирование ТТН</v8:content></v8:item>
      </Title>
      <Action>ОтправитьЗапрос</Action>
      <CurrentRowUse>DontUse</CurrentRowUse>
    </Command>
  </Commands>
</Form>
