&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АдресУТМ = "";
    FSRAR_ID = "";
    WBRegId = "";
    ОписаниеНакладной = "";
    Результат = "";
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУТМ(Команда)
    Список = ПолучитьСписокУТМНаСервере();
    Если Список = Неопределено Тогда
        Сообщить("Не удалось получить список подключений УТМ из 1С.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    Если ТипЗнч(Список) <> Тип("Массив") Тогда
        Сообщить("Ошибка: сервер вернул некорректный список УТМ.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    Если Список.Количество() = 0 Тогда
        Сообщить("В настройках 1С не найдено подключение к УТМ. Проверьте настройки интеграции с ЕГАИС.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    Значения = Новый СписокЗначений;
    Для каждого Элемент Из Список Цикл
        Значения.Добавить(Элемент, Элемент.Представление);
    КонецЦикла;

    Выбранное = Значения.ВыбратьЭлемент();
    Если Выбранное = Неопределено Тогда
        Возврат;
    КонецЕсли;

    АдресУТМ = Выбранное.Значение.Адрес;
    FSRAR_ID = Выбранное.Значение.FSRAR_ID;
    Результат = "Выбран УТМ: " + Выбранное.Значение.Представление;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьНакладную(Команда)
    Список = ПолучитьСписокНакладныхНаСервере();
    Если Список = Неопределено Тогда
        Сообщить("Не удалось получить список накладных из 1С.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    Если ТипЗнч(Список) <> Тип("Массив") Тогда
        Сообщить("Ошибка: сервер вернул некорректный список накладных.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    Если Список.Количество() = 0 Тогда
        Сообщить("В базе 1С не найдены документы ТТН/ЕГАИС. Можно указать WBRegId вручную.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    Значения = Новый СписокЗначений;
    Для каждого Элемент Из Список Цикл
        Значения.Добавить(Элемент, Элемент.Представление);
    КонецЦикла;

    Выбранное = Значения.ВыбратьЭлемент();
    Если Выбранное = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Ссылка = Выбранное.Значение.Ссылка;
    ДанныеНакладной = ПолучитьWBRegIdНаСервере(Ссылка, Выбранное.Значение.ИмяМетаданных);

    Если ДанныеНакладной <> Неопределено И ЗначениеЗаполнено(ДанныеНакладной.WBRegId) Тогда
        WBRegId = ДанныеНакладной.WBRegId;
        ОписаниеНакладной = Выбранное.Значение.Представление;
        Результат = "Выбрана накладная: " + ОписаниеНакладной + Символы.ПС + "WBRegId: " + WBRegId;
    Иначе
        ОписаниеНакладной = Выбранное.Значение.Представление;
        Результат = "Выбрана накладная, но WBRegId не найден автоматически." + Символы.ПС
            + "Укажите WBRegId ЕГАИС вручную в поле ниже.";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗапрос(Команда)
    Если ПустаяСтрока(АдресУТМ) Тогда
        Результат = "Ошибка: сначала выберите УТМ.";
        Возврат;
    КонецЕсли;
    Если ПустаяСтрока(FSRAR_ID) Тогда
        Результат = "Ошибка: у выбранного УТМ не найден FSRAR_ID.";
        Возврат;
    КонецЕсли;
    Если ПустаяСтрока(WBRegId) Тогда
        Результат = "Ошибка: выберите накладную или укажите WBRegId ЕГАИС.";
        Возврат;
    КонецЕсли;

    Результат = "Формируется запрос на аннулирование ТТН...";
    Результат = ОтправитьНаСервере(АдресУТМ, FSRAR_ID, WBRegId);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокУТМНаСервере() Экспорт
    Результат = Новый Массив;
    УникальныеАдреса = Новый Соответствие;

    Для каждого МетаРег Из Метаданные.РегистрыСведений Цикл
        ИмяРегистра = МетаРег.Имя;
        ИмяНР = НРег(ИмяРегистра);
        Если СтрНайти(ИмяНР, "егис") = 0 И СтрНайти(ИмяНР, "утм") = 0 И СтрНайти(ИмяНР, "алког") = 0 Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 200 * ИЗ РегистрСведений." + ИмяРегистра;
            Выборка = Запрос.Выполнить().Выбрать();

            Пока Выборка.Следующий() Цикл
                Адрес = "";
                ФСРАР = "";

                Для каждого Колонка Из Выборка.Колонки Цикл
                    Значение = Выборка[Колонка.Имя];
                    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
                        Продолжить;
                    КонецЕсли;

                    Текст = СокрЛП(Значение);
                    НТекст = НРег(Текст);
                    ИмяКолонки = НРег(Колонка.Имя);

                    Если Адрес = "" И (СтрНайти(НТекст, "http://") = 1 ИЛИ СтрНайти(НТекст, "https://") = 1) Тогда
                        Адрес = Текст;
                    КонецЕсли;

                    Если ФСРАР = "" И (СтрНайти(ИмяКолонки, "fsrar") > 0 ИЛИ СтрНайти(ИмяКолонки, "ид") > 0) Тогда
                        Если ЭтоFSRARID(Текст) Тогда
                            ФСРАР = Текст;
                        КонецЕсли;
                    КонецЕсли;

                    Если ФСРАР = "" И ЭтоFSRARID(Текст) Тогда
                        ФСРАР = Текст;
                    КонецЕсли;
                КонецЦикла;

                Если Адрес <> "" Тогда
                    Ключ = НРег(Адрес) + "|" + ФСРАР;
                    Если УникальныеАдреса.Получить(Ключ) = Неопределено Тогда
                        Элемент = Новый Структура;
                        Элемент.Вставить("Адрес", Адрес);
                        Элемент.Вставить("FSRAR_ID", ФСРАР);
                        Элемент.Вставить("Представление", ИмяРегистра + ": " + Адрес + ?(ФСРАР = "", "", " (FSRAR_ID " + ФСРАР + ")"));
                        Результат.Добавить(Элемент);
                        УникальныеАдреса.Вставить(Ключ, Истина);
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоFSRARID(Значение) Экспорт
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) <> 12 Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Номер = 1 По 12 Цикл
        Символ = Сред(Значение, Номер, 1);
        Если СтрНайти("0123456789", Символ) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокНакладныхНаСервере() Экспорт
    Результат = Новый Массив;

    Для каждого МетаДок Из Метаданные.Документы Цикл
        ИмяДокумента = МетаДок.Имя;
        ИмяНР = НРег(ИмяДокумента);
        Если СтрНайти(ИмяНР, "ттн") = 0 И СтрНайти(ИмяНР, "егис") = 0 И СтрНайти(ИмяНР, "наклад") = 0 Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, Номер, Дата ИЗ Документ." + ИмяДокумента + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Элемент = Новый Структура;
                Элемент.Вставить("Ссылка", Выборка.Ссылка);
                Элемент.Вставить("ИмяМетаданных", ИмяДокумента);
                Элемент.Вставить("Представление", МетаДок.Представление() + " №" + Выборка.Номер + " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy HH:mm"));
                Результат.Добавить(Элемент);
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьWBRegIdНаСервере(Ссылка, ИмяМетаданных) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("WBRegId", "");

    Попытка
        Объект = Ссылка.ПолучитьОбъект();
        МетаДок = Метаданные.Документы[ИмяМетаданных];

        Для каждого РеквизитМета Из МетаДок.Реквизиты Цикл
            ИмяРеквизита = НРег(РеквизитМета.Имя);
            Если СтрНайти(ИмяРеквизита, "wbreg") = 0 И СтрНайти(ИмяРеквизита, "ттн") = 0 И СтрНайти(ИмяРеквизита, "егис") = 0 И СтрНайти(ИмяРеквизита, "идентифик") = 0 Тогда
                Продолжить;
            КонецЕсли;

            Значение = Объект[РеквизитМета.Имя];
            Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
                Если СтрНайти(НРег(Значение), "ttn-") > 0 ИЛИ СтрДлина(Значение) >= 8 Тогда
                    Результат.WBRegId = СокрЛП(Значение);
                    Возврат Результат;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;

        Для каждого ТЧМета Из МетаДок.ТабличныеЧасти Цикл
            Попытка
                Таблица = Объект[ТЧМета.Имя];
                Для каждого СтрокаТЧ Из Таблица Цикл
                    Для каждого РеквизитМета Из ТЧМета.Реквизиты Цикл
                        ИмяРеквизита = НРег(РеквизитМета.Имя);
                        Если СтрНайти(ИмяРеквизита, "wbreg") = 0 И СтрНайти(ИмяРеквизита, "ттн") = 0 И СтрНайти(ИмяРеквизита, "егис") = 0 Тогда
                            Продолжить;
                        КонецЕсли;
                        Значение = СтрокаТЧ[РеквизитМета.Имя];
                        Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
                            Если СтрНайти(НРег(Значение), "ttn-") > 0 ИЛИ СтрДлина(Значение) >= 8 Тогда
                                Результат.WBRegId = СокрЛП(Значение);
                                Возврат Результат;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЦикла;
                КонецЦикла;
            Исключение
            КонецПопытки;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Возврат Результат;
КонецФункции

&НаСервере
Функция ОтправитьНаСервере(АдресУТМ, FSRAR_ID, WBRegId) Экспорт
    XML = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
        + "<ns:Documents Version=""1.0"" xmlns:ns=""http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_CAP"" xmlns:ce=""http://fsrar.ru/WEGAIS/Common"">" + Символы.ПС
        + "<ns:RequestRepealWB>" + Символы.ПС
        + "<ns:FSRAR_ID>" + FSRAR_ID + "</ns:FSRAR_ID>" + Символы.ПС
        + "<ns:WBRegId>" + WBRegId + "</ns:WBRegId>" + Символы.ПС
        + "</ns:RequestRepealWB>" + Символы.ПС
        + "</ns:Documents>";

    Попытка
        Соединение = Новый HTTPСоединение(СтрЗаменить(СтрЗаменить(АдресУТМ, "http://", ""), "https://", ""));
        Запрос = Новый HTTPЗапрос("/opt/in/RequestRepealWB");
        Запрос.Заголовки.Вставить("Content-Type", "application/xml; charset=UTF-8");
        Запрос.УстановитьТелоИзСтроки(XML, КодировкаТекста.UTF8);
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Возврат "УТМ ответил: " + Ответ.КодСостояния + " " + Ответ.ПолучитьТелоКакСтроку();
    Исключение
        Возврат "Ошибка отправки в УТМ: " + ОписаниеОшибки();
    КонецПопытки;
КонецФункции
