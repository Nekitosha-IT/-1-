&НаКлиенте
Процедура ПриОткрытии(Отказ)
    АдресУТМ = "http://localhost:8080";
    FSRAR_ID = "";
    Результат = "Готово. Нажмите «Получить данные из УТМ».";
    ИнициализироватьТаблицы();
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТаблицы()
    ТаблицаТТН = Новый ТаблицаЗначений;
    ТаблицаТТН.Колонки.Добавить("НомерТТН");
    ТаблицаТТН.Колонки.Добавить("Дата");
    ТаблицаТТН.Колонки.Добавить("Контрагент");
    ТаблицаТТН.Колонки.Добавить("Статус1С");
    ТаблицаТТН.Колонки.Добавить("СтатусЕГАИС");
    ТаблицаТТН.Колонки.Добавить("Расхождение");
    ТаблицаТТН.Колонки.Добавить("WBRegId");
    ТаблицаТТН.Колонки.Добавить("ОтмененаПоставщиком");
    ТаблицаТТН.Колонки.Добавить("Документ1С");
    ТаблицаТТН.Колонки.Добавить("Причина");

    ИсторияИсправлений = Новый ТаблицаЗначений;
    ИсторияИсправлений.Колонки.Добавить("НомерТТН");
    ИсторияИсправлений.Колонки.Добавить("Время");
    ИсторияИсправлений.Колонки.Добавить("СтатусИсправления");
    ИсторияИсправлений.Колонки.Добавить("Результат");
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУТМ(Команда)
    Список = ПолучитьСписокУТМНаСервере();
    Если Список = Неопределено ИЛИ ТипЗнч(Список) <> Тип("Массив") Тогда
        Сообщить("Не удалось получить список подключений УТМ.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
    Если Список.Количество() = 0 Тогда
        Сообщить("Подключение УТМ не найдено автоматически. Можно указать адрес вручную.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;

    Значения = Новый СписокЗначений;
    Для каждого Элемент Из Список Цикл
        Значения.Добавить(Элемент, Элемент.Представление);
    КонецЦикла;

    Выбранное = Значения.ВыбратьЭлемент();
    Если Выбранное = Неопределено Тогда Возврат; КонецЕсли;

    АдресУТМ = Выбранное.Значение.Адрес;
    FSRAR_ID = Выбранное.Значение.FSRAR_ID;
    Результат = "Выбран УТМ: " + Выбранное.Значение.Представление;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанные(Команда)
    Если ПустаяСтрока(АдресУТМ) Тогда
        Результат = "Укажите адрес УТМ.";
        Возврат;
    КонецЕсли;

    Результат = "Получаем актуальные данные из УТМ...";
    Данные = ПолучитьДанныеИзУТМНаСервере(АдресУТМ);
    Если Данные = Неопределено ИЛИ Не Данные.Успех Тогда
        Результат = ?(Данные = Неопределено, "УТМ не вернул результат.", Данные.Сообщение);
        Возврат;
    КонецЕсли;

    ТаблицаТТН.Очистить();
    Для каждого ТТН Из Данные.Данные Цикл
        СтрокаТТН = ТаблицаТТН.Добавить();
        СтрокаТТН.НомерТТН = ТТН.Номер;
        СтрокаТТН.Дата = ТТН.Дата;
        СтрокаТТН.Контрагент = ТТН.Контрагент;
        СтрокаТТН.СтатусЕГАИС = ТТН.СтатусЕГАИС;
        СтрокаТТН.WBRegId = ТТН.WBRegId;
        СтрокаТТН.ОтмененаПоставщиком = ТТН.ОтмененаПоставщиком;

        Найдено = НайтиТТНВ1СНаСервере(ТТН.WBRegId, ТТН.Номер, ТТН.Дата);
        Если Найдено.Найдена Тогда
            СтрокаТТН.Документ1С = Найдено.Ссылка;
            СтрокаТТН.Статус1С = Найдено.Статус;
            Если ТТН.ОтмененаПоставщиком Тогда
                СтрокаТТН.Расхождение = Истина;
                СтрокаТТН.Причина = "В ЕГАИС ТТН отменена поставщиком, а документ 1С ещё не закрыт.";
            КонецЕсли;
        Иначе
            СтрокаТТН.Статус1С = "Не найден";
            СтрокаТТН.Расхождение = Истина;
            СтрокаТТН.Причина = "ТТН есть в УТМ, но документ не найден в 1С.";
        КонецЕсли;
    КонецЦикла;

    Результат = "Получено документов из УТМ: " + Строка(ТаблицаТТН.Количество()) + ".";
КонецПроцедуры

&НаКлиенте
Процедура ИсправитьОтмененные(Команда)
    Количество = 0;

    Для каждого СтрокаТТН Из ТаблицаТТН Цикл
        Если Не СтрокаТТН.ОтмененаПоставщиком ИЛИ Не СтрокаТТН.Расхождение Тогда Продолжить; КонецЕсли;

        Журнал = ИсторияИсправлений.Добавить();
        Журнал.НомерТТН = СтрокаТТН.НомерТТН;
        Журнал.Время = ТекущаяДата();
        Журнал.СтатусИсправления = "Исправляется";
        Журнал.Результат = "Начато исправление. ТТН отменена поставщиком в ЕГАИС.";

        РезультатИсправления = ИсправитьТТННаСервере(СтрокаТТН.Документ1С, СтрокаТТН.WBRegId);
        Если РезультатИсправления.Успех Тогда
            Журнал.СтатусИсправления = "Исправлено";
            Журнал.Результат = РезультатИсправления.Сообщение;
            СтрокаТТН.Статус1С = "Отменена поставщиком";
            СтрокаТТН.Расхождение = Ложь;
            Количество = Количество + 1;
        Иначе
            Журнал.СтатусИсправления = "Ошибка исправления";
            Журнал.Результат = РезультатИсправления.Сообщение;
        КонецЕсли;
    КонецЦикла;

    Результат = "Исправление завершено. Успешно обработано: " + Строка(Количество) + ". История находится внизу формы.";
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ВывестиТекст("ЕГАИС — контроль и исправление ТТН");
    ТабДок.ВывестиТекст("Дата формирования: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss"));
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("ТТН\tДата\tКонтрагент\tСтатус 1С\tСтатус ЕГАИС\tРасхождение");
    Для каждого СтрокаТТН Из ТаблицаТТН Цикл
        ТабДок.ВывестиТекст(СтрокаТТН.НомерТТН + "\t" + Формат(СтрокаТТН.Дата, "ДФ=dd.MM.yyyy") + "\t" + СтрокаТТН.Контрагент + "\t" + СтрокаТТН.Статус1С + "\t" + СтрокаТТН.СтатусЕГАИС + "\t" + ?(СтрокаТТН.Расхождение, "ДА", "НЕТ"));
    КонецЦикла;
    ТабДок.ВывестиТекст("");
    ТабДок.ВывестиТекст("Журнал исправлений");
    ТабДок.ВывестиТекст("ТТН\tВремя\tСтатус исправления\tРезультат");
    Для каждого Журнал Из ИсторияИсправлений Цикл
        ТабДок.ВывестиТекст(Журнал.НомерТТН + "\t" + Формат(Журнал.Время, "ДФ=dd.MM.yyyy HH:mm:ss") + "\t" + Журнал.СтатусИсправления + "\t" + Журнал.Результат);
    КонецЦикла;
    ТабДок.Показать("ЕГАИС — отчёт по ТТН");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеИзУТМНаСервере(АдресУТМ) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "");
    Результат.Вставить("Данные", Новый Массив);

    ReplyId = "";
    Для НомерСтраницы = 1 По 100 Цикл
        XMLТекст = "";
        Путь = "/opt/out";
        Если ReplyId <> "" Тогда Путь = Путь + "?replyId=" + ReplyId; КонецЕсли;

        Если Не ВыполнитьHTTPЗапросУТМ(АдресУТМ, Путь, XMLТекст) Тогда
            Результат.Сообщение = ?(XMLТекст = "", "УТМ недоступен или вернул пустой ответ.", "Ошибка УТМ: " + XMLТекст);
            Возврат Результат;
        КонецЕсли;
        Если ПустаяСтрока(XMLТекст) Тогда Прервать; КонецЕсли;

        Разобранное = РазобратьXMLУТМ(XMLТекст);
        Для каждого Документ Из Разобранное.Данные Цикл Результат.Данные.Добавить(Документ); КонецЦикла;

        НовыйReplyId = ИзвлечьReplyIdИзXML(XMLТекст);
        Если НовыйReplyId = "" ИЛИ НовыйReplyId = ReplyId Тогда Прервать; КонецЕсли;
        ReplyId = НовыйReplyId;
    КонецЦикла;

    Результат.Успех = Истина;
    Результат.Сообщение = "Получено документов: " + Строка(Результат.Данные.Количество());
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьHTTPЗапросУТМ(АдресУТМ, Путь, ТелоОтвета) Экспорт
    ТелоОтвета = "";
    Попытка
        Сервер = АдресУТМ;
        Порт = 80;
        Если СтрНайти(НРег(Сервер), "http://") = 1 Тогда Сервер = Сред(Сервер, 8);
        ИначеЕсли СтрНайти(НРег(Сервер), "https://") = 1 Тогда Сервер = Сред(Сервер, 9); Порт = 443; КонецЕсли;
        ПозицияПорта = СтрНайти(Сервер, ":");
        Если ПозицияПорта > 0 Тогда Порт = Число(Сред(Сервер, ПозицияПорта + 1)); Сервер = Лев(Сервер, ПозицияПорта - 1); КонецЕсли;
        Соединение = Новый HTTPСоединение(Сервер, Порт, , , , 30);
        Запрос = Новый HTTPЗапрос(Путь);
        Запрос.Заголовки.Вставить("Accept", "application/xml");
        Ответ = Соединение.Получить(Запрос);
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
        Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда Возврат Ложь; КонецЕсли;
        Возврат Истина;
    Исключение
        ТелоОтвета = ОписаниеОшибки();
        Возврат Ложь;
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьXMLУТМ(XMLТекст) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Данные", Новый Массив);
    Попытка
        Чтение = Новый ЧтениеXML;
        Чтение.УстановитьСтроку(XMLТекст);
        Текущий = Неопределено;
        ИмяЭлемента = "";
        Пока Чтение.Прочитать() Цикл
            Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
                Имя = НРег(Чтение.Имя);
                Если Имя = "waybill" ИЛИ Имя = "actcancelcharge" ИЛИ Имя = "document" Тогда
                    Если Текущий <> Неопределено И Текущий.WBRegId <> "" Тогда
                        Текущий.СтатусЕГАИС = НормализоватьСтатус(Текущий.СтатусЕГАИС);
                        Текущий.ОтмененаПоставщиком = Текущий.ОтмененаПоставщиком ИЛИ ОпределитьОтмену(Текущий.СтатусЕГАИС, Текущий.ТипДокумента);
                        Результат.Данные.Добавить(Текущий);
                    КонецЕсли;
                    Текущий = Новый Структура;
                    Текущий.Вставить("WBRegId", "");
                    Текущий.Вставить("Номер", "");
                    Текущий.Вставить("Дата", Неопределено);
                    Текущий.Вставить("Контрагент", "");
                    Текущий.Вставить("СтатусЕГАИС", "");
                    Текущий.Вставить("ТипДокумента", Имя);
                    Текущий.Вставить("ОтмененаПоставщиком", Имя = "actcancelcharge");
                КонецЕсли;
                ИмяЭлемента = Имя;
            ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст И Текущий <> Неопределено Тогда
                Значение = СокрЛП(Чтение.Значение);
                Если ИмяЭлемента = "wbregid" Тогда Текущий.WBRegId = Значение;
                ИначеЕсли ИмяЭлемента = "number" Тогда Текущий.Номер = Значение;
                ИначеЕсли ИмяЭлемента = "date" Тогда Попытка Текущий.Дата = Дата(Значение); Исключение КонецПопытки;
                ИначеЕсли ИмяЭлемента = "status" ИЛИ ИмяЭлемента = "reason" Тогда Текущий.СтатусЕГАИС = Значение;
                ИначеЕсли ИмяЭлемента = "shortname" Тогда Текущий.Контрагент = Значение;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если Текущий <> Неопределено И Текущий.WBRegId <> "" Тогда
            Текущий.СтатусЕГАИС = НормализоватьСтатус(Текущий.СтатусЕГАИС);
            Текущий.ОтмененаПоставщиком = Текущий.ОтмененаПоставщиком ИЛИ ОпределитьОтмену(Текущий.СтатусЕГАИС, Текущий.ТипДокумента);
            Результат.Данные.Добавить(Текущий);
        КонецЕсли;
    Исключение
        Результат.Вставить("Ошибка", ОписаниеОшибки());
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьReplyIdИзXML(XMLТекст) Экспорт
    Позиция = СтрНайти(НРег(XMLТекст), "replyid");
    Если Позиция = 0 Тогда Возврат ""; КонецЕсли;
    Остаток = Сред(XMLТекст, Позиция);
    Начало = СтрНайти(Остаток, ">") + 1;
    Конец = СтрНайти(Сред(Остаток, Начало), "<");
    Если Начало <= 1 ИЛИ Конец = 0 Тогда Возврат ""; КонецЕсли;
    Возврат СокрЛП(Сред(Остаток, Начало, Конец - 1));
КонецФункции

&НаСервереБезКонтекста
Функция НормализоватьСтатус(Статус) Экспорт
    НР = НРег(СокрЛП(Статус));
    Если СтрНайти(НР, "отмен") > 0 И СтрНайти(НР, "поставщ") > 0 Тогда Возврат "Отменена поставщиком"; КонецЕсли;
    Если СтрНайти(НР, "принят") > 0 Тогда Возврат "Принята"; КонецЕсли;
    Если СтрНайти(НР, "выполн") > 0 Тогда Возврат "К выполнению"; КонецЕсли;
    Возврат Статус;
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьОтмену(Статус, ТипДокумента) Экспорт
    НР = НРег(Статус);
    Если СтрНайти(НР, "отменена поставщиком") > 0 ИЛИ СтрНайти(НР, "отменен поставщиком") > 0 Тогда Возврат Истина; КонецЕсли;
    Если НРег(ТипДокумента) = "actcancelcharge" Тогда Возврат Истина; КонецЕсли;
    Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиТТНВ1СНаСервере(WBRegId, НомерТТН, ДатаТТН) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Найдена", Ложь);
    Результат.Вставить("Ссылка", Неопределено);
    Результат.Вставить("Статус", "");

    Для каждого МетаДок Из Метаданные.Документы Цикл
        Имя = МетаДок.Имя;
        НР = НРег(Имя);
        Если СтрНайти(НР, "ттн") = 0 И СтрНайти(НР, "егис") = 0 И СтрНайти(НР, "наклад") = 0 Тогда Продолжить; КонецЕсли;
        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка, Номер, Дата ИЗ Документ." + Имя + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Если НомерТТН <> "" И Строка(Выборка.Номер) = НомерТТН Тогда
                    Результат.Найдена = Истина;
                    Результат.Ссылка = Выборка.Ссылка;
                    Результат.Статус = "Документ 1С";
                    Возврат Результат;
                КонецЕсли;
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ИсправитьТТННаСервере(Ссылка, WBRegId) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "");
    Если Ссылка = Неопределено Тогда
        Результат.Сообщение = "Документ 1С не найден. Автоматическое исправление не выполнено.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Объект = Ссылка.ПолучитьОбъект();
        Попытка
            Объект.Комментарий = "ЕГАИС: ТТН отменена поставщиком. WBRegId: " + WBRegId;
        Исключение
        КонецПопытки;
        Объект.Записать();
        Ссылка.УстановитьПометкуУдаления(Истина);
        Результат.Успех = Истина;
        Результат.Сообщение = "Документ записан и помечен на удаление. Причина: ТТН отменена поставщиком в ЕГАИС.";
    Исключение
        Результат.Сообщение = "Ошибка исправления: " + ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокУТМНаСервере() Экспорт
    Результат = Новый Массив;
    УникальныеАдреса = Новый Соответствие;
    Для каждого МетаРег Из Метаданные.РегистрыСведений Цикл
        ИмяРегистра = МетаРег.Имя;
        ИмяНР = НРег(ИмяРегистра);
        Если СтрНайти(ИмяНР, "егис") = 0 И СтрНайти(ИмяНР, "утм") = 0 И СтрНайти(ИмяНР, "алког") = 0 Тогда Продолжить; КонецЕсли;
        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 200 * ИЗ РегистрСведений." + ИмяРегистра;
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Адрес = "";
                ФСРАР = "";
                Для каждого Колонка Из Выборка.Колонки Цикл
                    Значение = Выборка[Колонка.Имя];
                    Если ТипЗнч(Значение) <> Тип("Строка") Тогда Продолжить; КонецЕсли;
                    Текст = СокрЛП(Значение);
                    Если Адрес = "" И (СтрНайти(НРег(Текст), "http://") = 1 ИЛИ СтрНайти(НРег(Текст), "https://") = 1) Тогда Адрес = Текст; КонецЕсли;
                    Если ФСРАР = "" И ЭтоFSRARID(Текст) Тогда ФСРАР = Текст; КонецЕсли;
                КонецЦикла;
                Если Адрес <> "" Тогда
                    Ключ = НРег(Адрес) + "|" + ФСРАР;
                    Если УникальныеАдреса.Получить(Ключ) = Неопределено Тогда
                        Элемент = Новый Структура;
                        Элемент.Вставить("Адрес", Адрес);
                        Элемент.Вставить("FSRAR_ID", ФСРАР);
                        Элемент.Вставить("Представление", ИмяРегистра + ": " + Адрес + ?(ФСРАР = "", "", " (FSRAR_ID " + ФСРАР + ")"));
                        Результат.Добавить(Элемент);
                        УникальныеАдреса.Вставить(Ключ, Истина);
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоFSRARID(Значение) Экспорт
    Значение = СокрЛП(Значение);
    Если СтрДлина(Значение) <> 12 Тогда Возврат Ложь; КонецЕсли;
    Для Номер = 1 По 12 Цикл
        Если СтрНайти("0123456789", Сред(Значение, Номер, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции
